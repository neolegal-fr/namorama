# ─── Base de données ────────────────────────────────────────────────────────
# MariaDB lancée via docker-compose (infra/docker-compose.yml)
DATABASE_URL=mariadb://admin:admin_password@localhost:3306/namorama

# `true` laisse TypeORM aligner le schéma sur les entités à chaque démarrage.
# Indispensable en dev (c'est ce qui crée les tables), à ne JAMAIS activer en
# production : la base y porte des comptes et des paiements, et la
# synchronisation supprime ou retype des colonnes sans relecture.
# Non définie ⇒ désactivée.
DB_SYNCHRONIZE=true

# ─── Keycloak ───────────────────────────────────────────────────────────────
# Realm pré-configuré, lancé via docker-compose
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=namorama
KEYCLOAK_CLIENT_ID=namorama-api
KEYCLOAK_SECRET=your-keycloak-client-secret

# ─── Fournisseur du modèle ──────────────────────────────────────────────────
# Qui sert TOUS les appels au modèle : `openai` (défaut) ou `anthropic`.
# La clé du fournisseur choisi est obligatoire : sans elle, l'API refuse de
# démarrer, en nommant la variable qui manque.
# AI_PROVIDER=openai
#
# Secours facultatif, joué sur un SEUL cas : le principal refuse un appel faute
# de crédit (solde Anthropic épuisé, quota OpenAI `insufficient_quota`). Une
# limite de débit ou une surcharge ne bascule pas. Sans la clé du secours, il
# est désactivé avec un avertissement au démarrage.
# AI_FALLBACK_PROVIDER=openai

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Obligatoire quand AI_PROVIDER=openai (ou non défini)
OPENAI_API_KEY=sk-...

# Modèles (optionnels — valeurs par défaut ci-dessous).
# IDs API GPT-5.6 : gpt-5.6-luna (rapide/éco), gpt-5.6-terra (équilibré), gpt-5.6-sol (max).
# OPENAI_MODEL          → tâches simples/rapides (reformulation, mots-clés, nom de projet)
# OPENAI_MODEL_CREATIVE → étapes créatives / à jugement (génération de noms, pick-best)
# OPENAI_MODEL_ANALYSIS → notation des noms sur 5 critères. Non définie ⇒ OPENAI_MODEL.
#   C'est une notation dans un JSON imposé, pas de la création : le modèle
#   simple la rend au dixième du prix du créatif. La passer sur
#   gpt-5.6-terra la ramène au comportement d'avant le 16/09/2026, sans
#   toucher à la génération de noms — c'est là que la qualité se joue.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_CREATIVE=gpt-5.6-terra
# OPENAI_MODEL_ANALYSIS=gpt-5.6-luna

# ─── Anthropic (Claude) ─────────────────────────────────────────────────────
# Obligatoire quand AI_PROVIDER=anthropic. Une clé API de la Console, créée
# dans l'organisation liée à l'abonnement Max (ses crédits mensuels s'y
# appliquent) — jamais le jeton OAuth de l'abonnement. Sur cette organisation,
# ni carte ni rechargement automatique : sinon, les crédits épuisés, la
# dépense continue sur la carte au lieu de passer au secours.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Mêmes trois rôles qu'OpenAI. AUCUNE valeur par défaut : ANTHROPIC_MODEL et
# ANTHROPIC_MODEL_CREATIVE sont obligatoires avec AI_PROVIDER=anthropic.
# ANTHROPIC_MODEL_ANALYSIS non définie ⇒ ANTHROPIC_MODEL.
# Candidats (tarifs $/M tokens entrée / sortie, relevés le 06/10/2026) :
#   simple  : claude-haiku-5-5 (0,10 / 0,50)
#   créatif : claude-sonnet-5-5 (2 / 10) · claude-opus-5-5 (4 / 20)
#   analyse : claude-haiku-5-5 · claude-sonnet-5-5
# Le choix se fait sur `api/scripts/comparer-fournisseurs.ts`, pas a priori.
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_CREATIVE=
# ANTHROPIC_MODEL_ANALYSIS=

# ─── Serveur ────────────────────────────────────────────────────────────────
# Le front (web/public/assets/config.json) appelle l'API sur :3001 en local.
PORT=3001
FRONTEND_URL=http://localhost:4200

# ─── Stripe (optionnel en dev local) ────────────────────────────────────────
# Laisser vide pour désactiver les paiements
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PACK_DECOUVERTE_PRICE_ID=price_...
STRIPE_PACK_PRO_PRICE_ID=price_...
STRIPE_PACK_MAX_PRICE_ID=price_...

# ─── SMTP (notifications feedback) ──────────────────────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@namorama.com
SMTP_PASS=your-smtp-password
SMTP_FROM=support@namorama.com
FEEDBACK_NOTIFY_EMAIL=support@namorama.com
# Page d'avis publics citée dans ces courriels. Vide : pas de lien.
# REVIEW_URL=https://fr.trustpilot.com/review/namorama.com

# ─── INPI — API PI diffusion (vérif marque, US-051) ─────────────────────────
# Compte INPI avec « Accès API PI » activé sur data.inpi.fr. Couvre FR+EU+WO.
# Absent → la vérif marque renvoie « unknown » + lien profond (repli propre).
INPI_USERNAME=votre-email@example.com
INPI_PASSWORD=votre-mot-de-passe

# ─── Rejeu des sessions (rrweb) ─────────────────────────────────────────────
# POST /replay est public et sans limite de débit : ces plafonds bornent ce
# qu'un tiers peut faire stocker. Défauts ci-dessous si absents.
# Conservation des enregistrements, en jours (purge quotidienne).
REPLAY_RETENTION_DAYS=30
# Taille compressée maximale d'UNE visite, en Mo (au-delà : 413, la capture s'arrête).
REPLAY_MAX_SESSION_MB=5
# Total compressé accepté par jour, toutes visites confondues, en Mo (au-delà : 429).
REPLAY_MAX_DAY_MB=200
